// This is your Prisma schema file
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  foto      String?   
  createdAt DateTime @default(now()) @map("create_at")

  // Relasi: Satu user dapat membuat banyak event
  events    Event[]

  @@map("users")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("create_at")

  // Relasi: Satu kategori dapat memiliki banyak event
  events    Event[]

  @@map("categories")
}

model Pembicara {
  id        Int      @id @default(autoincrement())
  name      String
  role      String
  image     String
  createdAt DateTime @default(now()) @map("create_at")

  // Relasi: Satu pembicara dapat mengisi banyak event
  events    Event[]

  @@map("pembicaras")
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  categoryId  Int       @map("category_id")
  location    String
  dateEvent   DateTime  @map("date_event")
  description String
  createdAt   DateTime  @default(now()) @map("create_at")

  // Relasi ke Category
  category    Category  @relation(fields: [categoryId], references: [id])

  // Relasi ke Pembicara
  pembicaraId Int       @map("pembicara_id")
  pembicara   Pembicara @relation(fields: [pembicaraId], references: [id])

  // Relasi ke User
  userId      Int       @map("user_id")
  user        User      @relation(fields: [userId], references: [id])

  @@map("events")
}
model Role{
  id        Int      @id @default(autoincrement())
  name     String   @unique
   createdAt DateTime @default(now()) @map("create_at")

   @@map("Roles")
}